<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Handfast" Language="1033" Version="$(var.Version)"
           Manufacturer="Handfast" UpgradeCode="7F4C4DB9-9355-493C-A898-C5AD678C0DA3">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Handfast is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="Handfast" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Handfast" />
      </Directory>
    </Directory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="HandfastdExe" Guid="4D6C071F-0764-4CD7-BC4D-F297B909216A">
        <File Id="HandfastdExe" Source="$(var.BinaryPath)" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Product>
</Wix>
