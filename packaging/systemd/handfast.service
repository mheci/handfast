[Unit]
Description=Handfast device-pairing daemon
Documentation=https://github.com/mheci/handfast
After=network-online.target
Wants=network-online.target
# PartOf ties the daemon to the graphical session so it stops (and restarts)
# with login/logout on desktop systems. It is optional: headless users who
# enable the unit directly under default.target are unaffected, since a unit
# that is not pulled in by graphical-session.target simply keeps running.
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/handfastd
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The daemon persists its SQLite database under $XDG_DATA_HOME (~/.local/share)
# plus configuration under ~/.config and regenerable caches under ~/.cache;
# ProtectSystem=strict otherwise renders those paths read-only.
ReadWritePaths=%h/.local/share/handfast %h/.config/handfast %h/.cache/handfast
# Provisions $XDG_RUNTIME_DIR/handfast (writable inside the sandbox) for the
# IPC socket; matches handfast_ipc::default_socket_path.
RuntimeDirectory=handfast
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
